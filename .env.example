# Node Ganache GUI (RPC Server). Ganache GUI: Chain ID 1337, Network ID 5777.
GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_CHAIN_ID=1337

# Private key akun Ganache untuk deploy (akun ini otomatis menjadi owner + operator)
PRIVATE_KEY=0x_private_key_ganache_anda

# Alamat CahyaAudioOrder hasil `npm run deploy` (dipakai Laravel; dApp membaca deployed-contract.json)
CONTRACT_ADDRESS=

# (Opsional) Akun operator bengkel tambahan yang didaftarkan saat deploy
OPERATOR_ADDRESS=

# Alamat HSportOrder hasil `npm run deploy:hsport` (dipakai scripts/interact.js)
HSPORT_ORDER_ADDRESS=
